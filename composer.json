{
  "name": "getlaraplate/larashop",
  "vendor": "getlaraplate",
  "description": "Laraplate Shop module: an online sales channel built on CMS content, ERP items and SAO support.",
  "version": "v0.1.0",
  "keywords": [
    "laravel",
    "laraplate",
    "shop",
    "ecommerce",
    "storefront"
  ],
  "authors": [
    {
      "name": "Swolley",
      "email": "myentity@inwind.it"
    }
  ],
  "license": "AGPL-3.0-or-later",
  "type": "laravel-module",
  "require": {
    "php": ">=8.5",
    "laravel/framework": "^12.0"
  },
  "scripts": {
    "update:requirements": [
      "composer bump",
      "npx npm-check-updates -u"
    ]
  },
  "extra": {
    "laravel": {
      "providers": [],
      "aliases": {}
    }
  },
  "autoload": {
    "psr-4": {
      "Modules\\Shop\\": "app/",
      "Modules\\Shop\\Database\\Factories\\": "database/factories/",
      "Modules\\Shop\\Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Modules\\Shop\\Tests\\Unit\\": "tests/Unit",
      "Modules\\Shop\\Tests\\Feature\\": "tests/Feature",
      "Modules\\Shop\\Tests\\Integration\\": "tests/Integration",
      "Modules\\Shop\\Tests\\Support\\": "tests/Support/"
    },
    "classmap": [
      "tests/TestCase.php"
    ]
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}